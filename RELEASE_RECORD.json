  "knownIssues": [
    {
      "id": "DEPENDENCY-OPENPGP",
      "status": "watch",
      "description": "x/crypto 模块包含未维护 OpenPGP 公告 GO-2026-5932；项目不直接导入该包。每次发布重新扫描，若发现实际可达漏洞必须阻断发布。"
    },
    {
      "id": "BEPUSDT-LIVE-ACCEPTANCE",
      "status": "pending_acceptance",
      "description": "USDT 充值默认关闭；真实网关、小额链上付款及数据库并发重复回调验收尚未完成，启用前必须验收。"
    },
    {
      "id": "BEPUSDT-MD5-PROTOCOL",
      "status": "protocol_risk",
      "description": "BEpusdt 上游采用 MD5 参数签名；仅对协议 import/调用作有理由的扫描注释。默认关闭，强制 HTTPS、独立高熵 Token 和严格结算校验；不代表现代强认证协议。"
    },
    {
      "id": "PORTAL-BUNDLE-SIZE",
      "status": "optimization",
      "description": "用户端主 JavaScript chunk 超过 500 kB，构建有体积警告；后续优化分包和首屏加载。"
    },
    {
      "id": "TRAFFIC-REPORTING-AND-RETRY",
      "status": "operational_risk",
      "description": "1.6.5 保留新节点与 API 的持久批次队列、去重凭据及原子事务；必须先升级 API 再升级节点，旧节点兼容接口仍无批次去重。额度流量目标每 30 秒尝试上报、普通流量仍为 5 分钟，网络和配置同步会延迟拦截，不是分布式即时硬限额。超期、损坏或身份不匹配的队列需备份核对，不可删除或改号重传；回滚 API 前须排空新节点队列。"
    },
    {
      "id": "BANDWIDTH-WINDOW-CHECKPOINT",
      "status": "operational_risk",
      "description": "1.6.5 保留节点带宽窗口的周期持久化和升级恢复处理；检查点间隔内的内存计数、磁盘故障及断电仍可能造成少计，不承诺零丢失。升级前保留节点数据与队列，并按先管理端/API、后节点的顺序更新。"
    },
    {
      "id": "LIVE-WRITE-AND-FAILURE-DRILLS",
      "status": "pending_acceptance",
      "description": "本版本构建不代表完成业务写操作、更新失败回滚、通知渠道、跨机恢复或 HA 验收；真实部署测试须单独引用本构建编号。"
    }
  ],
